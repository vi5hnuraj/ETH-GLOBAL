JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here
PORT=5550

RELAYER_PRIVATE_KEY=your_relayer_private_key
TREASURY_PRIVATE_KEY=your_treasury_private_key

# Arc Testnet Configuration (Circle L1 with USDC Native Gas)
NETWORK=arc-testnet
CHAIN_NAME="Arc Testnet"
CHAIN_ID=5042002
ARC_CHAIN_ID=5042002
RPC_URL="https://rpc.testnet.arc.io"
RPC_URLS="https://rpc.testnet.arc.io,https://rpc.blockdaemon.testnet.arc.io,https://rpc.drpc.testnet.arc.io,https://rpc.quicknode.testnet.arc.io"
EXPLORER_URL="https://testnet.arcscan.app/"
SYMBOL="USDC"
GAS_SYMBOL="USDC"
PAYMENT_MODE=USDC
FAUCET_URL="https://faucet.circle.com"

GLOBAL_PAY_MANAGER_ADDRESS=0x775Ab463A19E51072C61bAe94A0931E00F7caa42

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_DATABASE_URL=postgresql://postgres:...

# Wallet Configuration
WALLET_PROVIDER=mpc
MPC_SERVICE_URL=http://localhost:8101
MPC_SERVICE_TOKEN=dev-service-token
MPC_RPC_TIMEOUT_MS=20000

NODE_ENV=development
