# Environment switch: "production" uses the strict, fail-closed production
# loader (config.Load). Anything else boots the local-dev/testnet node
# (config.LoadDev) with readable dev defaults. Keep this empty for development.
MPC_ENV=

# One distinct deployment identity per node; never copy a node's secret paths
# or certificates to another node.
MPC_NODE_ID=node-a
MPC_NODE_URL=https://mpc-node-a.internal
MPC_NODE_A_URL=https://mpc-node-a.internal
MPC_NODE_B_URL=https://mpc-node-b.internal
MPC_NODE_C_URL=https://mpc-node-c.internal
MPC_NODE_PORT=8080
MPC_THRESHOLD=2
MPC_PARTIES=3
MPC_SIGNING_PAUSED=true
SECRET_BACKEND=vault
MPC_SHARE_SECRET_REF=kv/data/globalpay/mpc/prod/node-a/share
MPC_MTLS_CA_FILE=/run/secrets/mpc-ca.pem
MPC_MTLS_CERT_FILE=/run/secrets/node-a-cert.pem
MPC_MTLS_KEY_FILE=/run/secrets/node-a-key.pem
MPC_PEER_MESSAGE_SIGNING_KEY_REF=kv/data/globalpay/mpc/prod/node-a/peer-message-key
MPC_REPLAY_DATABASE_URL=
MPC_ALLOWED_PEER_SPIFFES=spiffe://globalpay/mpc/node-b,spiffe://globalpay/mpc/node-c
MPC_ALLOWED_API_SPIFFE=spiffe://globalpay/api
MPC_PROTOCOL_TIMEOUT_MS=15000
MPC_REQUEST_TTL_SECONDS=60
MPC_RATE_LIMIT_PER_MINUTE=60

# ── Production-only, REQUIRED by the strict loader (fail closed) ─────────────
# Per-node bearer tokens used by the peer verifier. Each node's token must be
# unique and NOT a known dev value (dev-token-*).
MPC_NODE_A_TOKEN=
MPC_NODE_B_TOKEN=
MPC_NODE_C_TOKEN=
# Per-node 32-byte hex HMAC secrets used to sign/verify peer messages. Each
# node's secret must be unique and NOT a known dev value.
MPC_NODE_A_SECRET=
MPC_NODE_B_SECRET=
MPC_NODE_C_SECRET=
# Per-node 32-byte hex share-encryption key. Must be unique per node, unique
# from every peer HMAC secret, and NOT a known dev value. A node's environment
# only needs its OWN key (MPC_SHARE_KEY_A on node-a, etc.).
MPC_SHARE_KEY_A=
MPC_SHARE_KEY_B=
MPC_SHARE_KEY_C=
# At least one service credential for the public coordinator/API routes.
# Must NOT be the known dev value "dev-service-token".
MPC_ALLOWED_API_TOKENS=

MPC_DKG_LIBRARY=github.com/bnb-chain/tss-lib/v3
MPC_DKG_LIBRARY_VERSION=v3.0.0
